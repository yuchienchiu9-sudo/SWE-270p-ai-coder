# Project-specific, approved dependencies are installed at IMAGE BUILD time,
# never while generated Python executes. Do not use arbitrary pip specifications.
FROM python:3.12-slim
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
RUN pip install --no-cache-dir pytest==9.2.0 streamlit==1.67.0
ARG EXTRA_PACKAGES=""
# EXTRA_PACKAGES is constructed from the trusted pinned catalog on the host.
RUN if [ -n "$EXTRA_PACKAGES" ]; then pip install --no-cache-dir $EXTRA_PACKAGES; fi
WORKDIR /workspace
USER 65534:65534
