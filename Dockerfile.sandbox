# Dependencies are installed when building the image, never at runtime.
FROM python:3.12-slim
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
RUN pip install --no-cache-dir pytest==9.2.0 streamlit==1.67.0
WORKDIR /workspace
USER 65534:65534
